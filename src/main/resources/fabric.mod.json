{
  "schemaVersion": 1,
  "id": "w1zox",
  "version": "${version}",
  "name": "w1zox",
  "description": "Client-side chunk and visible-spawner utilities for Meteor Client.",
  "authors": ["w1zox"],
  "environment": "client",
  "entrypoints": {
    "meteor": ["de.w1zox.W1zoxAddon"]
